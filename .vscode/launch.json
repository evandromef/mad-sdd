{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Backend: Spring Boot",
      "request": "launch",
      "cwd": "${workspaceFolder}/codebase/backend",
      "mainClass": "br.com.mad.MadApplication",
      "projectName": "mad-api",
      "env": {
        "SPRING_PROFILES_ACTIVE": "development"
      }
    },
    {
      "type": "chrome",
      "name": "Frontend: Angular",
      "request": "launch",
      "preLaunchTask": "Frontend: iniciar",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/codebase/frontend"
    }
  ]
}
